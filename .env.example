# ─────────────────────────────────────────────────────────────
# EIMS environment configuration
# Copy to `.env.local` for local development, and add the same keys
# in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Which data backend to use:
#   demo     → fully working in-browser demo (data saved in localStorage, sample data, demo logins)
#   firebase → Google Firebase Auth + Firestore (fill in the keys below)
VITE_DATA_BACKEND=demo

# Firebase Web App config (Firebase Console → Project settings → Your apps → SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: connect to the local Firebase Emulator Suite instead of production (true/false)
VITE_FIREBASE_USE_EMULATORS=false
# Only if you changed the emulator ports in firebase.json
# VITE_FIREBASE_EMULATOR_FIRESTORE_PORT=8080
# VITE_FIREBASE_EMULATOR_AUTH_PORT=9099
