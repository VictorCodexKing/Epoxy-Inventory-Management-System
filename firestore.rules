rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// EIMS Security Rules
//
//  Super Admin (role 'admin')  → full read/write on business data, user management.
//  Normal User (role 'user')   → read-only: materials, locations, batches (physical stock).
//                                 NEVER reads lotCosts, purchaseOrders, sales, transfers,
//                                 movements or counters — so cost data cannot leak via the SDK.
//  Nothing is ever hard-deleted. Ledgers (movements, lotCosts) are append-only.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function isActive() {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.status == 'active';
    }
    function isAdmin() {
      return isActive() && get(profilePath()).data.role == 'admin';
    }
    function onlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys) && request.resource.data.keys().hasAll(keys);
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // First sign-in: a user may create ONLY their own profile, ONLY as an active Normal User.
      // Accounts themselves are created by the owner in Firebase Console (disable public sign-up).
      allow create: if signedIn()
        && request.auth.uid == uid
        && onlyKeys(['email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt', 'deletedAt', 'deletedBy'])
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.deletedAt == null
        && request.resource.data.deletedBy == null;

      // Admins can change OTHER users' role, or delete (tomb-stone) them. Deleted users stay deleted.
      allow update: if isAdmin()
        && uid != request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['role', 'status', 'deletedAt', 'deletedBy', 'updatedAt'])
        && request.resource.data.role in ['admin', 'user']
        && request.resource.data.status in ['active', 'deleted'];

      allow delete: if false;
    }

    // ── Catalogue (readable by everyone signed in) ─────────────────────────
    match /materials/{id} {
      allow read: if isActive();
      allow create, update: if isAdmin()
        && request.resource.data.baseUnit in ['kg', 'L', 'pcs']
        && request.resource.data.name is string
        && request.resource.data.lowStockThreshold is number
        && request.resource.data.lowStockThreshold >= 0
        && request.resource.data.packaging is list;
      allow delete: if false;
    }

    match /locations/{id} {
      allow read: if isActive();
      allow create, update: if isAdmin()
        && request.resource.data.type in ['internal', 'vendor']
        && request.resource.data.name is string;
      allow delete: if false;
    }

    // ── Physical stock (no cost fields) ────────────────────────────────────
    match /batches/{id} {
      allow read: if isActive();
      allow create, update: if isAdmin()
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0;
      allow delete: if false;
    }

    // ── Financial / admin-only ─────────────────────────────────────────────
    // Lot costs are written once on receipt and never change.
    match /lotCosts/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /purchaseOrders/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /sales/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /transfers/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // Append-only stock ledger.
    match /movements/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Sequential document numbers (PO-2026-0001 …).
    match /counters/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.value is int;
      allow delete: if false;
    }

    // Anything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
